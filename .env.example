# Copy this file to `.env` and fill it in. `.env` is git-ignored: never commit your keys.
# In the cloud, set these as environment variables in your host's dashboard instead.

# --- Required -------------------------------------------------------------
# Claude API key for the chat agent: https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=

# Telegram bot token: in Telegram, message @BotFather and send /newbot
TELEGRAM_BOT_TOKEN=
# Optional: your numeric Telegram user id(s), comma-separated, to lock the bot to you.
# If empty, the first person to message the bot becomes its owner.
TELEGRAM_ALLOWED_USER_IDS=

# --- Optional: chat model and spending ------------------------------------
# NBA_AGENT_MODEL=claude-opus-5-5
# NBA_AGENT_EFFORT=medium
# Hard spending cap per conversation, in US cents (100 = $1.00)
# NBA_AGENT_CHAT_BUDGET_CENTS=100

# --- Optional: settings page from other devices / in the cloud ------------
# Without this, the settings page only opens on the machine running the app.
# NBA_AGENT_ADMIN_PASSWORD=

# --- Optional: where data is stored (default ./data; /data in Docker) ------
# NBA_AGENT_DATA_DIR=

# --- Optional: WhatsApp (official Cloud API) --------------------------------
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=any-random-string-you-also-type-into-meta
# WHATSAPP_ALLOWED_NUMBERS=15551234567
# WHATSAPP_TEMPLATE=nba_digest
